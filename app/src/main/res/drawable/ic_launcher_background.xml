<?xml version="1.0" encoding="utf-8"?>
<!-- Plain <shape>, not a vector: GradientDrawable's <gradient> has been supported since API 1,
     so this renders identically across every supported OS version, unlike embedding a gradient
     fill inside a <vector> path (which needs API 24's GradientColor to render correctly). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#0061A4"
        android:centerColor="#2E5AAC"
        android:endColor="#5B3FA0" />
</shape>
