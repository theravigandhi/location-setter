    <string name="setup_step1_title">1. Enable Developer Options</string>
    <string name="setup_step1_instructions">Go to Settings → About phone, then tap "Build number" 7 times until you see "You are now a developer!".</string>
    <string name="setup_open_developer_options">Open Developer Options</string>
    <string name="setup_step2_title">2. Select Location Setter as the mock location app</string>
    <string name="setup_step2_instructions">In Developer Options, scroll to "Select mock location app" and choose Location Setter. This can only be set manually by you — the app cannot do it for you.</string>
    <string name="setup_step3_title">3. Grant location permission</string>
    <string name="setup_step3_instructions">Location Setter needs the "Allow all the time" or "While using the app" location permission to publish mock coordinates.</string>
